# Dockerfile for building libwebp.dll on Windows x64 (64-bit)
# Uses Windows Server Core with Visual Studio Build Tools
# Fixed to produce 64-bit DLL by specifying x64 architecture

FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS builder

SHELL ["powershell", "-Command", "-NoLogo", "-ExecutionPolicy", "Bypass"]

# Set working directory
WORKDIR /build

# Install Chocolatey (package manager)
RUN powershell -NoProfile -Command "Write-Host 'Installing Chocolatey...' -ForegroundColor Yellow; [System.Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls3072; iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1')); choco feature disable --name showDownloadProgress" && echo 'Chocolatey installed successfully'"

# Install Visual Studio Build Tools for x64
RUN choco install -y visualstudio2019buildtools --package-parameters "--add Microsoft.VisualStudio.Workload.VCTools;includeRecommended --architecture x64"

# Install build tools via Chocolatey
RUN choco install -y git cmake ninja

# Clone libwebp repository
RUN git -c http.sslVerify=false clone --depth 1 --branch v1.6.0 https://chromium.googlesource.com/webm/libwebp .

# Create build directory and configure with CMake for x64
RUN powershell -NoProfile -Command "if (Test-Path build) { Remove-Item -Recurse build } else { New-Item -ItemType Directory -Force build; Write-Host 'Build directory created' }"
RUN cd build && powershell -NoProfile -Command "cmake .. -G 'Visual Studio 17 2022 Win64' -A x64 -DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=Release 2>&1 | Out-File cmake.log; if ($LASTEXITCODE -neq 0) { Get-Content cmake.log }"

# Build library with Ninja
RUN cd build && powershell -NoProfile -Command "ninja 2>&1 | Out-File ninja.log; if ($LASTEXITCODE -neq 0) { Get-Content ninja.log }"

# Find and copy DLL to output
RUN powershell -NoProfile -Command "$dllFile = Get-ChildItem -Path build -Filter *.dll | Where-Object { -not $_.PSIsContainer }; if ($dllFile) { Copy-Item -Path $dllFile.FullName -Destination C:\output\libwebp.dll -Force; Write-Host ('DLL found and copied to C:\output\libwebp.dll'); Get-Item -Path C:\output\libwebp.dll | Format-Table -AutoSize } else { Write-Host ('No DLL found in build directory, searching...'); Get-ChildItem -Path build -Recurse -Filter *.dll -Depth 20 | Format-Table -AutoSize }"

# Verify DLL is 64-bit
RUN powershell -NoProfile -Command "$dll = 'C:\output\libwebp.dll'; if (Test-Path $dll) { $sig = [System.Reflection.AssemblyName]::GetAssemblyName($dll).GetBytes(); $is64bit = $sig[23] -eq 0x8b; if ($is64bit) { Write-Host 'SUCCESS: libwebp.dll is 64-bit' -ForegroundColor Green } else { Write-Host 'ERROR: libwebp.dll is 32-bit' -ForegroundColor Red } } else { Write-Host 'ERROR: DLL not found' -ForegroundColor Red }"

# Create output directory
RUN powershell -NoProfile -Command "if (-not (Test-Path C:\output)) { New-Item -ItemType Directory -Force C:\output; Write-Host 'Output directory created' }"

WORKDIR /output

# Set label
LABEL maintainer="legiosoft"
LABEL description="libwebp.dll (64-bit) built for Windows x64 using Visual Studio 17 2022 Win64"

# Default command to verify DLL is 64-bit
CMD ["powershell", "-NoLogo", "-Command", "$dll = 'C:\\output\\libwebp.dll'; if (Test-Path $dll) { $sig = [System.Reflection.AssemblyName]::GetAssemblyName($dll).GetBytes(); $is64bit = $sig[23] -eq 0x8b; if ($is64bit) { Write-Host 'EXISTS: libwebp.dll is 64-bit' -ForegroundColor Green -Format-Table -AutoSize } else { Write-Host 'ERROR: libwebp.dll is 32-bit' -ForegroundColor Red -Format-Table -AutoSize } } else { Write-Host 'NOT FOUND' -ForegroundColor Red -Format-Table -AutoSize }"]
