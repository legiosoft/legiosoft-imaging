<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LegioSoft.Imaging.Skia</RootNamespace>
    <AssemblyName>LegioSoft.Imaging.Skia</AssemblyName>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <PackageId>LegioSoft.Imaging.Skia</PackageId>
    <Description>
      Full-featured image processing library built on SkiaSharp. Implements ILegioImageResizer, ILegioImageCropper, ILegioImageTransformer, and ILegioImageFilter interfaces. Provides fluent builder API for easy image manipulation. Supports resize, crop, rotate, flip, and filters (grayscale, sepia, blur, sharpen, brightness, contrast, invert). Format conversion for PNG, JPEG, and WebP. Cross-platform support for Windows, macOS, and Linux. Supports .NET 6.0, 7.0, 8.0, 9.0, and 10.0.
    </Description>
    <PackageTags>image;processing;SkiaSharp;resize;crop;transform;rotate;flip;grayscale;sepia;blur;sharpen;brightness;contrast;invert;format-conversion;builder-pattern;filters;color-adjustments;cross-platform;bitmap;security;validation;modular-operations</PackageTags>
    <PackageReleaseNotes>
      Initial beta release of LegioSoft.Imaging.Skia.

      Features:
      - Refactored into modular structure (Core, Operations, Processors modules)
      - Fluent builder API (LegioImageBuilder) for easy image manipulation
      - Resize operations with multiple scale modes (Fit, Fill, Stretch)
      - Crop, rotate (90/180/270 degrees), flip (horizontal/vertical)
      - Filter operations: grayscale, sepia, blur (configurable radius), sharpen
      - Color adjustments: brightness, contrast, invert
      - Format conversion: PNG, JPEG, WebP
      - Secure image saving with validation and quality adjustment
      - Automatic format detection (moved to Core package)
      - Quality control (0-100) for lossy formats
      - Load from file, byte array, or stream
      - Save to file, byte array, or stream
      - Image info extraction (width, height, format, alpha channel)
      - Cross-platform (Windows, macOS, Linux)
      - Support for .NET 6.0, 7.0, 8.0, 9.0, and 10.0
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LegioSoft.Imaging.Skia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegioSoft.Imaging.Core\LegioSoft.Imaging.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.6" />
    </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
