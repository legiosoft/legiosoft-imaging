<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LegioSoft.Imaging.WebP</RootNamespace>
    <AssemblyName>LegioSoft.Imaging.WebP</AssemblyName>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <PackageId>LegioSoft.Imaging.WebP</PackageId>
    <Description>
      Lightweight WebP codec implementation using native libwebp. Provides efficient WebP encoding and decoding without SkiaSharp dependency. Implements ILegioImageEncoder and ILegioImageDecoder interfaces from LegioSoft.Imaging.Core. Includes native libraries for Windows (x64), Linux (x64 and ARM64). Perfect for scenarios requiring only WebP support without the overhead of full image processing library. Supports .NET 6.0, 7.0, 8.0, 9.0, and 10.0.
    </Description>
    <PackageTags>image;WebP;encode;decode;codec;lossless;lightweight;cross-platform;libwebp</PackageTags>
    <PackageReleaseNotes>
      1.0.0-beta1 - Initial beta release of LegioSoft.Imaging.WebP.

      Features:
      - WebP encoding and decoding via native libwebp
      - Implements ILegioImageEncoder and ILegioImageDecoder interfaces
      - Native libraries for Windows x64, Linux x64, and Linux ARM64
      - Lightweight (~500KB package size)
      - No SkiaSharp dependency
      - Cross-platform support
      - Support for .NET 6.0, 7.0, 8.0, 9.0, and 10.0
    </PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegioSoft.Imaging.Core\LegioSoft.Imaging.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes\win-x64\libwebp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes\win-x64\</PackagePath>
    </None>
    <None Include="runtimes\linux-x64\libwebp.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes\linux-x64\</PackagePath>
    </None>
    <None Include="runtimes\linux-arm64\libwebp.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes\linux-arm64\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
